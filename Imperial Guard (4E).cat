              </constraints>
            </entryLink>
            <entryLink import="true" name="Extra Armour" hidden="false" id="8115-4b75-70ad-79fe" type="selectionEntry" targetId="7b24-f9b1-5eb5-8bbd">
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="5"/>
              </costs>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0379-4a31-6e6e-7796" includeChildSelections="false"/>
              </constraints>
            </entryLink>
