    <selectionEntry type="upgrade" import="true" name="Imperial Guard 2003 — Catalogue Notes" hidden="false" id="78c1-a23f-8729-8285">
      <categoryLinks>
        <categoryLink name="Force Customization" hidden="false" id="2a00-79a0-195e-effe" targetId="7466-cf81-3a11-64ab" primary="true"/>
      </categoryLinks>
      <constraints>
        <constraint type="min" value="0" field="selections" scope="parent" shared="true" id="2f1f-ed87-70ea-956b" includeChildSelections="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="146a-40e3-960c-a9e6" includeChildSelections="false"/>
      </constraints>
      <costs>
        <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
      </costs>
      <profiles>
        <profile name="Source" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="d8b3-4642-2d14-b311">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Codex: Imperial Guard (2003), the scanned 68-page codex supplied for this catalogue. Profiles, points and army-list restrictions are transcribed from its Armoury, Army List, Doctrines and Summary sections.</characteristic>
          </characteristics>
        </profile>
        <profile name="Complex per-model costs" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="a879-bdd2-18d0-1744">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Squad-wide grenade costs and Storm Trooper deployment/meltabomb costs are calculated from model count. Rough Rider hunting lances are selected individually at +3 points. Warrior Weapons point costs are calculated from normally lasgun-armed model counts; weapon-display replacement and a few cross-option interactions still warrant manual checking.</characteristic>
          </characteristics>
        </profile>
        <profile name="Doctrine enforcement" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="cbb7-5cad-ebac-1b79">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Restricted Troop visibility, Doctrine incompatibilities, optional per-unit Skills/Drills, Special Equipment application, and Mechanised transport requirements are automated. Core force-structure limits (including Armoured Fist/Conscript ratios), Restricted Troop visibility, Doctrine incompatibilities, optional per-unit Skills/Drills, Special Equipment application, Mechanised transport requirements, and Storm Trooper transport/deployment exclusivity are automated. A few model-replacement interactions (especially Command Squad weapon allocation and Rough Rider lance/special-weapon exclusivity) still require manual validation.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </selectionEntries>
