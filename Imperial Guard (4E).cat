                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Creed has Iron Discipline.</characteristic>
              </characteristics>
            </profile>
            <profile name="Master Strategist" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="c3f2-2e59-9fd3-9e93">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Where there is a choice of mission based on Strategy Rating, an army containing Creed may choose the mission. It may choose to win the roll for table edge or request that the die for first turn be re-rolled.</characteristic>
              </characteristics>
            </profile>
          </profiles>
