            <profile name="Bodyguard" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="0e15-af43-32b4-4935">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If within 2" of Creed, Kell may change places with him at the start of either player’s Assault phase; Kell then fights Creed’s opponents and Creed fights Kell’s, if any.</characteristic>
              </characteristics>
            </profile>
            <profile name="Officer Privileges" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="0810-9dfd-9101-1ab3">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Although nominally a sergeant, Kell has all privileges of an Officer, including the Command special rules.</characteristic>
              </characteristics>
            </profile>
