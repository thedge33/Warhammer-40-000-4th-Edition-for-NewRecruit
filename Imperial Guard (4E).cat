        <profile name="Vox-caster" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="7ab6-1ca3-2fec-feed">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If a Command HQ or Command Section has a vox-caster, one squad per turn that also has a vox-caster may use the Officer’s Leadership regardless of distance. The vox may be used whenever the squad is about to take a Leadership test, even if the Command unit is in reserve. Standards and trademark items do not transmit through the vox.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Master-vox" hidden="false" id="6314-6188-7a20-1ca1">
      <profiles>
        <profile name="Master-vox" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="078e-62ae-fcfe-3710">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Upgrades the Command HQ vox-caster. Any number of squads with vox-casters may use the HQ Officer’s Leadership; each squad may do so for a single Morale or Leadership test per turn instead of the normal one-squad-per-turn vox limit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Medi-pack" hidden="false" id="d0fc-17f8-a33f-f3a8">
      <profiles>
        <profile name="Medi-pack" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="0f53-adde-85f2-eb24">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Once per turn, ignore the first failed saving throw in the unit. It cannot be used against Instant Death, AP1/2 attacks, or close-combat attacks that allow no Armour Save, and cannot be used while the medic is in base contact with an enemy.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Company Standard" hidden="false" id="6b73-5adf-66a1-cf2b">
      <profiles>
        <profile name="Company Standard" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="efa5-5c87-8909-7050">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Imperial Guard infantry units within 12" may re-roll failed Morale tests, excluding Conscripts, Enginseers, Ogryns, Ratlings and Storm Troopers.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Regimental Standard" hidden="false" id="80de-961a-89e5-813c">
      <profiles>
        <profile name="Regimental Standard" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="ce30-adca-2e7f-c0e1">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Counts as a Company Standard. Add +1 to the Imperial Guard side’s combat resolution for any assault taking place at least partly within 6" of the regimental standard.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Targeter" hidden="false" id="d7b7-76bf-b67e-2b85">
      <profiles>
        <profile name="Targeter" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="be02-7d37-d8d0-06dc">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Allows its bearer to pre-measure range to a target before deciding who to shoot in the Shooting phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Carapace Armour" hidden="false" id="d42c-74e3-2f97-9dc3">
      <profiles>
        <profile name="Carapace Armour" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="7c54-b45e-8643-4465">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The bearer has a 4+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Refractor Field" hidden="false" id="658f-0a35-4c9a-783a">
      <profiles>
        <profile name="Refractor Field" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="8d27-5644-d2dd-7cf6">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers a 5+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rosarius" hidden="false" id="5ca6-677c-6853-b771">
      <profiles>
        <profile name="Rosarius" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="40fa-256a-0a85-007e">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers a 4+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Bionics" hidden="false" id="4ea5-145a-6b29-7992">
      <profiles>
        <profile name="Bionics" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="2e95-4447-768e-c029">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">At the start of the next turn after the bearer suffers a crippling injury, roll a D6. On a 6 the model returns with 1 Wound; otherwise remove it as a casualty.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Medallion Crimson" hidden="false" id="0dfa-b575-55fe-7e98">
      <profiles>
        <profile name="Medallion Crimson" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="884a-e22c-84a3-247c">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The first time the bearer is wounded by an attack that causes Instant Death, it instead causes a single wound.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Trademark Item" hidden="false" id="d5f1-38ad-00be-29c0">
      <profiles>
        <profile name="Trademark Item" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="eee5-2786-a392-3840">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A unit led personally by the bearer may re-roll failed Morale or Pinning checks. If the bearer is slain, the unit must take a Morale test to avoid falling back.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Macharian Cross" hidden="false" id="45ca-c88e-e952-c666">
      <profiles>
        <profile name="Macharian Cross" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="ec66-4b8b-bcac-32d7">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">After deployment is complete but before the first turn, one Infantry Squad within 6" of the Officer may be redeployed up to 12", remaining within the mission deployment zone.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Honorifica Imperialis" hidden="false" id="e5cc-5b49-a843-66af">
      <profiles>
        <profile name="Honorifica Imperialis" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="79df-4529-0562-ff3f">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The bearer uses the Heroic Senior Officer profile while remaining otherwise the same character. Maximum one per army.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="9250-d05f-eb56-a586" includeChildSelections="false"/>
      </constraints>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Holy Relic" hidden="false" id="e6bf-f502-d9a8-93e9">
      <profiles>
        <profile name="Holy Relic" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="b4ce-c02c-bd4b-a9d6">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Once per battle, if the bearer does not move in the turn it is revealed, friendly models within 2D6" gain +1 Attack for the rest of that turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="f65e-d7a8-a0e4-7f36" includeChildSelections="false"/>
      </constraints>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Purity Seals" hidden="false" id="d057-cba4-e4c1-3e26">
      <profiles>
        <profile name="Purity Seals" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="02dd-4b60-9de1-475b">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If the bearer’s unit falls back, roll one extra D6 for fall-back distance and discard one die of your choice.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Surveyor" hidden="false" id="6047-c3af-f98c-1f31">
      <profiles>
        <profile name="Surveyor" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="f241-f947-3319-bc0d">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If enemy infiltrators set up within 4D6" of the bearer, the bearer may take a free shot at them before the battle begins; if part of a unit, the whole unit may shoot.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="2509-22f5-4f1c-5ac8">
      <profiles>
        <profile name="Signum" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="72d8-b652-c572-d33c">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Once each turn, the Techpriest Enginseer or one attendant Servitor may re-roll one missed To Hit roll in the Shooting phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Camo Netting" hidden="false" id="6eda-4828-309c-4cdd">
      <profiles>
        <profile name="Camo Netting" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="fbef-102b-7c8f-f35f">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">In scenarios using Hidden Set-up, a vehicle with camo netting may be set up hidden anywhere in its deployment zone, not only in/behind suitable terrain.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Improved Comms" hidden="false" id="af9d-d334-d14d-e1cc">
      <profiles>
        <profile name="Improved Comms" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="37aa-aad7-e581-50b4">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Allows one Reserve roll per turn to be re-rolled and allows a re-roll when checking whether a preliminary bombardment hits a friendly unit/obstacle.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Mine Sweeper" hidden="false" id="710b-6834-05ae-9b7c">
      <profiles>
        <profile name="Mine Sweeper" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="d86e-9c47-9f71-ee1c">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Allows the vehicle to enter a minefield without being attacked; the crossed minefield is cleared and removed from play.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rough Terrain Modification" hidden="false" id="99ba-34da-5198-d735">
      <profiles>
        <profile name="Rough Terrain Modification" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="2138-1f11-61b0-1a95">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A vehicle moving no further than 6" that turn may re-roll a failed Difficult Terrain test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Track Guards" hidden="false" id="92c8-1a30-267f-9f37">
      <profiles>
        <profile name="Track Guards" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="7c6b-0489-edc6-690f">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Treat an Immobilised result as Crew Stunned instead on a D6 roll of 4+; this applies even if the vehicle has extra armour.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Armoured Crew Compartment" hidden="false" id="8c75-f7ae-b3f0-d9ba">
      <profiles>
        <profile name="Armoured Crew Compartment" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="b295-e0b2-2b75-e21f">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">An open-topped vehicle fitted with this no longer counts as open-topped.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Pintle Heavy Stubber" hidden="false" id="03e1-2857-b3e1-f5b0">
      <profiles>
        <profile name="Pintle Heavy Stubber" typeId="576561706f6e23232344415441232323" typeName="Weapon" hidden="false" id="4d1f-b512-9689-8961">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">36"</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">6</characteristic>
            <characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 3</characteristic>
            <characteristic name="Info" typeId="33e9-27bd-77e4-401d">Pintle-mounted.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Pintle Storm Bolter" hidden="false" id="96b3-9180-0ff6-b0ff">
      <profiles>
        <profile name="Pintle Storm Bolter" typeId="576561706f6e23232344415441232323" typeName="Weapon" hidden="false" id="d96d-5a65-3901-c925">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">5</characteristic>
            <characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 2</characteristic>
            <characteristic name="Info" typeId="33e9-27bd-77e4-401d">Pintle-mounted.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
