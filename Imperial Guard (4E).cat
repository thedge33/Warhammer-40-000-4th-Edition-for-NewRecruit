            <characteristic name="BS" typeId="4.2532323234441546e+23">4</characteristic>
            <characteristic name="S" typeId="5.323232344415441e+21">3(4)</characteristic>
            <characteristic name="T" typeId="5.423232344415441e+21">3</characteristic>
            <characteristic name="W" typeId="5.723232344415441e+21">3</characteristic>
            <characteristic name="I" typeId="4.923232344415441e+21">4</characteristic>
            <characteristic name="A" typeId="4.123232344415441e+21">3</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Sv" typeId="5.361766523232344e+27">5+</characteristic>
          </characteristics>
        </profile>
        <profile name="Army Requirement" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="5ef7-2239-d603-d8a2">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">May be included in an Imperial Guard army of 1,500 points or more and counts as one HQ choice; must be used exactly as listed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sword of Hieronymo" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="0928-9db6-7246-0e8b">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Master-crafted power sword; hits at Strength 4 and also counts as a trademark item.</characteristic>
          </characteristics>
        </profile>
        <profile name="Front-liner" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="0538-2d10-124c-743b">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If an assault is occurring within 12" of Gaunt at the start of the Imperial Guard turn and he is not in combat, he must move toward the nearest combat and assault if possible. When Gaunt charges, all Tanith Imperial Guard models in that combat gain +1 Attack for that round.</characteristic>
          </characteristics>
        </profile>
        <profile name="Camo-cloak" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="1fa7-eb2d-2b45-9ac7">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Adds +1 to any Cover save (for example 5+ becomes 4+); gives no Cover save in the open.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fearless" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="8ad3-dc2d-7a07-4ba7">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Never takes Morale or Pinning tests and confers this to a joined unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="318a-a9e1-32ae-1989">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Advisors does not apply; he may act independently. Any Imperial Guard unit within 12" may use his Leadership for Morale and Pinning tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
