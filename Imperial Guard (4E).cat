              <profiles>
                <profile name="Upgrade Last Chancer to Specialist" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="3770-3d1e-b577-d76c">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Each Specialist may carry one special or heavy weapon and up to 15 points of Imperial Guard Armoury equipment. Heavy weapon teams require a non-specialist loader. Up to five sub-units may be formed; no sub-unit may contain more than one demolition charge.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Psyker Specialist" hidden="false" id="952f-9ee0-3d97-825f">
