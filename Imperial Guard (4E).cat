                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">As Xeno-fighters, applied to Eldar (including Dark Eldar).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Xeno-fighters: Tyranids" hidden="false" id="9a4a-47d1-38dd-fe5c">
