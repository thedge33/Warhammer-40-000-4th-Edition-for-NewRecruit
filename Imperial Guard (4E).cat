    <selectionEntry type="model" import="true" name="Commissar Yarrick" hidden="false" id="4c6f-f369-01f9-dac9">
      <categoryLinks>
        <categoryLink name="HQ" hidden="false" id="2e9a-657f-9209-1bc4" targetId="0d45-9523-cfd8-4efd" primary="true"/>
      </categoryLinks>
      <profiles>
        <profile name="Commissar Yarrick" typeId="556e697423232344415441232323" typeName="Unit" hidden="false" id="f8a4-ccc4-03ca-3c4c">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry</characteristic>
            <characteristic name="WS" typeId="5.753232323444154e+23">5</characteristic>
            <characteristic name="BS" typeId="4.2532323234441546e+23">4</characteristic>
            <characteristic name="S" typeId="5.323232344415441e+21">3</characteristic>
            <characteristic name="T" typeId="5.423232344415441e+21">3</characteristic>
            <characteristic name="W" typeId="5.723232344415441e+21">3</characteristic>
            <characteristic name="I" typeId="4.923232344415441e+21">4</characteristic>
            <characteristic name="A" typeId="4.123232344415441e+21">3</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Sv" typeId="5.361766523232344e+27">4+</characteristic>
          </characteristics>
        </profile>
        <profile name="Army Requirement" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="37d3-d613-5922-f1d2">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">May be included in an Imperial Guard army of 2,000 points or more. Counts as one HQ choice and must be used exactly as listed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master-crafted Storm Bolter" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="d01a-446c-252e-9642">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Yarrick’s storm bolter is master-crafted.</characteristic>
          </characteristics>
        </profile>
        <profile name="Battle Claw" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="d7cb-ab6d-c091-afa0">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Counts as a power fist.</characteristic>
          </characteristics>
        </profile>
        <profile name="Force Field" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="6da3-a7d5-596e-0b46">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Whenever Yarrick is hit, roll a D6 and subtract it from the attack Strength. If reduced to 0 or less the attack is stopped. No effect on attacks without a Strength value.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bale Eye" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="942b-111f-4f60-3614">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Once per Assault phase at normal Initiative, in addition to base attacks, automatically inflicts one S4 AP- hit on one model in base contact chosen by the Imperial Guard player.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fearless" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="3563-9965-32c3-feda">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Yarrick never takes Morale or Pinning tests and confers this to a joined unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="e6d3-4fed-8b08-6535">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The Advisors rule does not apply; he may act independently or join any squad without another Independent Character. He does not perform Summary Execution, but executes a Sanctioned Psyker subject to It’s For Your Own Good.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
