              <profiles>
                <profile name="Light Infantry" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="ff33-30ba-ad5c-0a13">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Guard Infantry without a transport may buy this for +10 points per unit: roll an additional die for difficult terrain movement and may Infiltrate; an eligible normal Infantry Platoon squad that does not take a heavy weapon may upgrade one lasgun to a sniper rifle for +5. May not combine with Carapace Armour or Mechanised.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="0" field="fc9c-4876-a564-fda8">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="7346-1dd7-8b9f-0f90" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
