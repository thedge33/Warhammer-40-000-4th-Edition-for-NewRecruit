                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="d78d-f0bb-422b-a608" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Sharpshooters" hidden="false" id="a1ef-6091-71b0-53bc">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b56d-2453-f86f-3b5b" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Sharpshooters" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="3508-9bcd-e481-034f">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Any Guard Infantry unit containing at least one BS3 model may buy this for +10 points. BS3 Guard Infantry may re-roll To Hit rolls of 1 when shooting, except with plasma weapons.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Xeno-fighters: Orks" hidden="false" id="76a1-18b8-0d06-329b">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="567a-a72b-d474-9b2d" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Xeno-fighters: Orks" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="8a95-f698-4122-3995">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Guard Infantry/Sentinels may buy this for +5 points per unit/Sentinel; in close combat they hit Orks with a WS characteristic on 3+ regardless of relative WS, except Independent Characters and Monstrous Creatures.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Xeno-fighters: Eldar/Dark Eldar" hidden="false" id="cf81-4f5e-69e0-b382">
              <constraints>
