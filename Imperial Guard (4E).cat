            <characteristic name="Capacity" typeId="8285-4205-b6cd-8473">12</characteristic>
            <characteristic name="Fire Points" typeId="b270-a7f9-22b2-3702">6 hull lasguns + 1 top hatch</characteristic>
            <characteristic name="Access Points" typeId="d17b-0342-b1dc-b8e7">Rear ramp</characteristic>
          </characteristics>
        </profile>
      </profiles>
