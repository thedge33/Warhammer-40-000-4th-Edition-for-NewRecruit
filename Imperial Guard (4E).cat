        <profile name="Fanatical" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="6048-f826-6927-8b5f">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A Priest and his assigned unit may re-roll failed To Hit rolls in the turn they charge while the Priest lives.</characteristic>
          </characteristics>
        </profile>
        <profile name="Righteous Fury" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="ceac-61c5-8e59-76ec">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A unit including a Priest must charge in the Assault phase if an enemy is in reach. It always counts as moving, even if stationary, and therefore cannot fire Heavy weapons.</characteristic>
          </characteristics>
        </profile>
