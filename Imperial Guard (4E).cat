      <profiles>
        <profile name="Commissar" typeId="556e697423232344415441232323" typeName="Unit" hidden="false" id="796e-b937-15af-3f95">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry</characteristic>
            <characteristic name="WS" typeId="5.753232323444154e+23">4</characteristic>
            <characteristic name="BS" typeId="4.2532323234441546e+23">4</characteristic>
            <characteristic name="S" typeId="5.323232344415441e+21">3</characteristic>
            <characteristic name="T" typeId="5.423232344415441e+21">3</characteristic>
            <characteristic name="W" typeId="5.723232344415441e+21">2</characteristic>
            <characteristic name="I" typeId="4.923232344415441e+21">4</characteristic>
            <characteristic name="A" typeId="4.123232344415441e+21">2</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Sv" typeId="5.361766523232344e+27">5+</characteristic>
          </characteristics>
        </profile>
        <profile name="Summary Execution" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="de05-c65c-626d-a3c0">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If a unit with a Commissar fails a Morale check, the Commissar executes the Officer or Sergeant leading it; the unit is then treated as having passed the test and continues under the Commissar’s Leadership. His presence also adds +1 to the Leadership characteristic of the Officer/Sergeant commanding the unit for tests affecting that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="It’s For Your Own Good!" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="303a-1142-c92f-b529">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If a Sanctioned Psyker in the same unit suffers Perils of the Warp while using a power, the Commissar immediately executes the Psyker; the attempted power does not work.</characteristic>
          </characteristics>
        </profile>
      </profiles>
