            <selectionEntry type="upgrade" import="true" name="2 — Telepathic Order" hidden="false" id="f228-b8b9-f129-7ea3">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9a15-e661-d23e-ad1e" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="2 — Telepathic Order" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="5fcc-c57b-7381-8200">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Used at start of Imperial Guard turn. On a passed Psychic test, the Leadership radius of an Officer in the same squad becomes 18" until the start of the next Imperial Guard turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="3 — Psychic Ward" hidden="false" id="b075-6888-f516-6390">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3f68-5837-facc-1c8c" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="3 — Psychic Ward" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="1413-7551-5fbd-0eff">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If a psychic power would normally affect the Psyker or his unit, make a Psychic test; if passed, cancel the enemy power on 4+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="4 — Psychic Lash" hidden="false" id="2d21-e291-97e2-2590">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="89bd-6f41-f90c-f634" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="4 — Psychic Lash" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="826e-a160-6e69-5b80">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">At the start of the Imperial Guard Assault phase, pass a Psychic test. Until next Imperial Guard Assault phase, in close combat the Psyker makes D3 attacks at S3 that ignore Armour Saves instead of attacking normally.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="5 — Machine Curse" hidden="false" id="9005-c6a6-9b98-c38e">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="652b-b508-aeba-cca3" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="5 — Machine Curse" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="fbda-e6aa-2bbc-1d38">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">In any Assault phase instead of normal attacks, pass Psychic test then make one close-combat hit against a vehicle; on D6 4–5 inflict glancing, 6 penetrating.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="6 — Lightning Arc" hidden="false" id="3edb-05a2-aba1-9573">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="965e-fbbb-45dc-907e" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="6 — Lightning Arc" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="ab44-4369-e8cb-e5ff">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">In the Imperial Guard Shooting phase instead of firing a normal weapon, pass Psychic test; Range 24", S3, AP6, Heavy D6.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="model" import="true" name="Commissars" hidden="false" id="6c97-f885-0bb4-f878">
      <categoryLinks>
        <categoryLink name="Additional Units" hidden="false" id="aa87-4c33-5bca-b662" targetId="0589-7c29-bfa2-d566" primary="true"/>
