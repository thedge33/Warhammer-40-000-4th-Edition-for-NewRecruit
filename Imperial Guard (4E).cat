      <profiles>
        <profile name="Army Requirement" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="d975-1ff8-262c-f1a0">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">May lead a Cadian army of at least 1,500 points. Creed and Kell must be used together and occupy a single HQ slot. Victory points are scored from wounds inflicted on Creed only; none for Kell.</characteristic>
          </characteristics>
        </profile>
      </profiles>
