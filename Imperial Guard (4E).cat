                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">As Xeno-fighters, applied to Tyranids. Does not apply to Tyranid Monstrous Creatures or Independent Characters.</characteristic>
                  </characteristics>
