            <selectionEntry type="upgrade" import="true" name="Drop Troops" hidden="false" id="453b-1878-a555-3da9">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6f28-2b88-bd43-7a5c" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Drop Troops" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="8120-aefc-e36a-728a">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Any Guard Infantry unit without a Chimera, or any Sentinel Squadron, may Deep Strike if the mission permits. May not be combined with Warrior Weapons.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="0" field="6f28-2b88-bd43-7a5c">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="6a65-9228-bf61-41e5" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Grenadiers" hidden="false" id="b6a2-f188-bea5-6f42">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="55c7-1b8e-049e-1314" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Grenadiers" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="b396-a5d4-1683-1889">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The regiment may include 0–3 Storm Trooper squads as Troops. These squads may not Deep Strike or Infiltrate. May not be combined with Warrior Weapons.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="0" field="55c7-1b8e-049e-1314">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="6a65-9228-bf61-41e5" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Mechanised" hidden="false" id="7346-1dd7-8b9f-0f90">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a7f1-9d31-efc3-11cd" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Mechanised" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="8b82-fce1-a2e9-c4e5">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">All Guard Infantry units must take a Chimera transport whether they normally have that option or not. May not be combined with Warrior Weapons or Light Infantry.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="0" field="a7f1-9d31-efc3-11cd">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="6a65-9228-bf61-41e5" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
                <modifier type="set" value="0" field="a7f1-9d31-efc3-11cd">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="c5ce-b3ef-5ead-47db" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Close Order Drill" hidden="false" id="e9a6-d518-c03e-6944">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f40e-9577-2543-c96a" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Close Order Drill" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="46ca-d1a7-45bc-c6aa">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Used only by units in standard Infantry Platoons and Conscript Platoons. While every model is in base-to-base contact, the unit has +1 Leadership and +1 Initiative; the Leadership bonus applies only when using the unit’s own Leadership.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Die-hards" hidden="false" id="7b4a-26e3-cff7-2e8d">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b9c5-f817-b6d7-1827" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Die-hards" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="7231-81e8-ed2e-8aeb">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Any Guard Infantry unit or Rough Rider Squadron may buy this at +5 points per unit. The unit ignores negative Morale modifiers for being outnumbered in close combat. May not be combined with Chem-inhalers.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="0" field="b9c5-f817-b6d7-1827">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="941d-21e6-8141-0ad5" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Iron Discipline" hidden="false" id="d38a-c464-b248-3a6d">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="24fa-0648-2f7f-d440" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Iron Discipline" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="d9fa-672c-3e39-4fb7">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Any Officer may buy this at +5 points. A unit using that Officer’s Leadership for a Morale or Pinning test ignores the -1 modifier for being under half strength and may regroup below half strength. May not be combined with Chem-inhalers.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="0" field="24fa-0648-2f7f-d440">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="941d-21e6-8141-0ad5" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Independent Commissars" hidden="false" id="5cae-0470-2a4d-9264">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a5a7-d30b-255f-44d7" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Independent Commissars" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="7185-ea58-2674-b677">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Commissars may be fielded as independent characters; 1–3 form a single Elites choice. Each costs +10 points above the normal Commissar cost.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hardened Fighters" hidden="false" id="3c3f-b887-0df4-d7e2">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a59b-8996-4baf-b351" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Hardened Fighters" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="f798-3163-6330-8cb4">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Guard Infantry units may buy +1 WS for +15 points per unit; Sentinels may buy +1 WS and +1 A for +10 points per Sentinel.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Jungle Fighters" hidden="false" id="59c2-2bfc-b0af-33c7">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dfa9-99d0-6561-2170" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
              </costs>
              <profiles>
                <profile name="Jungle Fighters" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="c165-bafe-83f7-8056">
                  <characteristics>
                    <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Guard Infantry may buy this for +10 points per unit: see 12" through forest/jungle; 4+ Cover save in forest/jungle; move at full speed there; may Infiltrate if the mission permits and deploys in woods/jungle; eligible Infantry Platoon squads may replace a heavy weapon team with one heavy flamer at +15; Jungle Fighter units may not include lascannons; Armour Save becomes 6+. May not combine with Cameleoline or Carapace Armour.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="0" field="dfa9-99d0-6561-2170">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="8964-e99b-7c99-3c12" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
                <modifier type="set" value="0" field="dfa9-99d0-6561-2170">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="d78d-f0bb-422b-a608" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Light Infantry" hidden="false" id="c5ce-b3ef-5ead-47db">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fc9c-4876-a564-fda8" includeChildSelections="false"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="0"/>
