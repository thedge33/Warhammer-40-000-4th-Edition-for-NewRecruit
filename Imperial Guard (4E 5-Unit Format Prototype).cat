    <selectionEntry id="0f68a32e-e6b7-d4fc-3812" name="Maximillian Weisemann (IA)" hidden="false" collective="false" import="true" type="upgrade">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="375a-d331-f8e5-1936" type="equalTo" childName="FW: Imperial Armour"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="bddf6fe9-06fc-1886-a4a2" name="Hardened Crew" hidden="false">
          <description>The vehicle treats all 'Driver Stunned' results on the damage tables as 'Crew Shaken' instead.</description>
        </rule>
        <rule id="571febac-59f8-f55e-94fa" name="Skilled Gunnery" hidden="false">
          <description>Nominate a single weapon at the start of the shooting phase. You may re-roll any misses to-hit rolls with that weapon this turn. For ordnance, this allows you to re-roll the scatter dice.</description>
        </rule>
        <rule id="312c0961-d30f-1eea-b4e9" name="Tank Shock" hidden="false">
          <description>Enemy infantry must test at -1 Leadership if they are Tank Shocked.</description>
        </rule>
        <rule id="3fa7b48b-7adb-f986-580d" name="Ordnance" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule id="2b82799c-70ee-7ed2-4891" name="Lumbering Vehicle" hidden="false">
          <description>Moves up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="4a3b6192-cf63-1e5b-592c" name="Difficult Terrain" hidden="false">
          <description>Ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule id="f33c0cd3-36b0-0ea9-7b57" name="Targetting" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0078f403-4af0-98cf-0d75" name="Baneblade" hidden="false" targetId="f84f80e3-f6fe-237b-8e92" type="profile">
          <modifiers>
            <modifier type="set" field="a6a5-1595-da9e-6155" value="4"/>
