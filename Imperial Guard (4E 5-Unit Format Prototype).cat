      </entryLinks>
    </selectionEntryGroup>
    <selectionEntryGroup id="62622164-2c24-3d0b-f4c0" name="Navy Vehicle Upgrades" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="398499e7-1539-7874-11e8" name="Ejector Seats" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="4deb-313d-6685-f48b" value="20">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e460c4d3-a3ad-f468-b53f" type="instanceOf"/>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2da2f1d6-209a-c4be-3428" type="instanceOf"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2642ec28-3a68-77ca-068f" type="max"/>
          </constraints>
          <rules>
            <rule id="06fe55d0-3451-18f4-089e" name="Ejector Seats" hidden="false">
              <description>If the aircraft is destroyed roll a D6. On a 1-3 nothing happens. On a 4+ the crewman successfully ejects. Roll a Scatter Dice and 4D6" for the direction and distance from the aircraft the crewman lands. Each crewman counts a single Guardsman with a laspistol. They are considered to be below half strength for the purposes of moral checks, claiming table quarters, etc. If any crew survice the aircraft will only count as damaged for the purposes of Victory Points at the end of the game.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="4deb-313d-6685-f48b" value="10"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="2fb0cad1-2f3e-3e7a-97b1" name="Flare/Chaff Launcher" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e8a7d3a9-aba6-4af3-d417" type="max"/>
          </constraints>
          <rules>
            <rule id="326d13c0-4927-d509-b429" name="Flare/Chaff Launcher" hidden="false">
              <description>One use only. If the vehicle takes the Immobilised damage result then re-roll the result.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="4deb-313d-6685-f48b" value="5"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="a9d2b810-ad49-1fd4-bdb5" name="Armoured Cockpit" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c0b47fda-cfd3-0263-6e91" type="max"/>
          </constraints>
          <rules>
            <rule id="a7c69059-3c74-af1f-31eb" name="Armoured Cockpit" hidden="false">
              <description>If the aircraft takes the Crew Shaken, Crew Stunned, or Pilot Shaken result, then roll a D6. On a 4+ the result is ignored.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="4deb-313d-6685-f48b" value="20"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="44e9f8e6-8a7d-c851-b9b5" name="Infrared Targeting" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6875cd15-3de1-9eaa-9745" type="max"/>
          </constraints>
          <rules>
            <rule id="761e57da-912e-a099-eb0b" name="Infrared Targeting" hidden="false">
              <description>The aircraft can re-roll the dice for the distance it can engage enemiers during a Night Fighting mission.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="4deb-313d-6685-f48b" value="10"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="525be804-f6a3-6801-a335" name="Illum Flare" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="37439524-17e6-bebc-40e1" type="max"/>
          </constraints>
          <rules>
            <rule id="006801ef-ade9-3eae-ce0a" name="Illum Flare" hidden="false">
              <description>This flare is used in missions where the Night Fighting rules are in effect. They allow one enemy unit spotted by the aircraft to be fired at in the next turn by any other ground forces in range and that have line of sight.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="4deb-313d-6685-f48b" value="3"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="196a7f63-4c05-2866-e2b3" name="Nose Art" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6efa4187-df47-935a-7fc9" type="max"/>
          </constraints>
          <rules>
            <rule id="3162811e-4198-7cfb-d232" name="Nose Art" hidden="false">
              <description>In the player's own turn, after the aircraft has attacked in the opponent's turn, the first unit to fail a Moral test may re-roll the test.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="4deb-313d-6685-f48b" value="10"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup xmlns="http://www.battlescribe.net/schema/gameSystemSchema" name="Special Bolter Ammo" id="6b462999-ff52-81d5-211a" hidden="false" collective="false" import="true">
