      <rules>
        <rule id="df52b95e-90a8-aa28-fe8a" name="Sanctioned Psyker Powers" hidden="false">
          <description>The psyker has one Psychic ability, selected at random by rolling a dice and consulting the table below:
1 - No usable power
2 - Telepathic Order
3 - Psychic Ward
4 - Psychic Lash
5 - Machine Curse
6 - Lightning Arc</description>
        </rule>
      </rules>
