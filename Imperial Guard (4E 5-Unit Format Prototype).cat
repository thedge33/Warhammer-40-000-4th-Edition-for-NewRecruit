    <selectionEntry id="ffd878e9-1002-014f-151d" name="Colonel Schaffer's Last Chancers" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="add" field="category" value="23e2-2a28-50f4-a3c1">
          <conditions>
            <condition field="selections" scope="parent" value="8" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="57907e84-bc5e-ae85-9adc" type="atLeast"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="d74b736d-98ca-42d4-21ca" name="Sub-Units" hidden="false">
          <description>At the start of any game you can break the Last Chancers, including Kage and Schaeffer, into a maximum of five sub-units. Each can consist of as few as one model. Members of the same heavy weapon team must be in the same unit, and no sub-unit can have more than one demolition charge or Chimera.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="e07c47aa-abe7-d97e-34fa" name="Deep Strike" hidden="false" targetId="bbf5-b1c2-49b0-f3c2" type="rule"/>
        <infoLink id="92d067bf-3048-7f8e-7a08" name="Infiltrators" hidden="false" targetId="c27d-09d4-6a09-1bcd" type="rule"/>
      </infoLinks>
      <categoryLinks>
