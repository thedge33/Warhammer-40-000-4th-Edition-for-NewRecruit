      </modifiers>
      <rules>
        <rule id="cb7d1c7a-a3c9-5548-ab85" name="Towing Vehicle" hidden="false">
          <description>The Trojan may move an Earthshaker, Hydra, or Manticore platform fitted with carriages that is limbered to the Trojan. Limbering and unlimbering a plaform takes an entire turn each, and neither the Trojan or plaform may fire weapons or move during that turn.</description>
        </rule>
      </rules>
