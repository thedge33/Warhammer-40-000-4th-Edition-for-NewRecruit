        <selectionEntryGroup id="a79d5df0-8107-30a6-f3b7" name="Hunting Lance" hidden="false" collective="false" import="true" sortIndex="2">
          <modifierGroups>
            <modifierGroup>
              <comment>This logic may seem odd. What happens is that when # of RRs is 5, the max number of lances shoots up to 9. By subtracting by 4 when we reach five, we counteract the fact it adds in four extra lances. We cannot set the max to 0 because it does not display the option to select lances without it being a max &gt; 0.</comment>
              <modifiers>
                <modifier type="increment" field="b2226375-2daf-77b7-f378" value="1">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6fe2cea4-4ca4-8ecf-4513" repeats="1" roundUp="false"/>
                  </repeats>
                  <conditions>
                    <condition field="selections" scope="parent" value="4" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6fe2cea4-4ca4-8ecf-4513" type="greaterThan"/>
                  </conditions>
                </modifier>
                <modifier type="decrement" field="b2226375-2daf-77b7-f378" value="1">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="bf9b57f1-374c-6d93-31cf" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
                <modifier type="decrement" field="b2226375-2daf-77b7-f378" value="4">
                  <conditions>
                    <condition field="selections" scope="parent" value="4" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6fe2cea4-4ca4-8ecf-4513" type="greaterThan"/>
                  </conditions>
                </modifier>
              </modifiers>
            </modifierGroup>
          </modifierGroups>
          <constraints>
            <constraint field="selections" scope="parent" value="4" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b2226375-2daf-77b7-f378" type="max"/>
          </constraints>
          <selectionEntries>
