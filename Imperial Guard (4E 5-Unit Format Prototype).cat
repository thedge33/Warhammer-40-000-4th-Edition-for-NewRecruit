                          </costs>
                        </selectionEntry>
                        <selectionEntry id="d5d4d357-2508-9bf5-654c" name="Iron Halo" hidden="false" collective="false" import="true" type="upgrade">
                          <constraints>
                            <constraint field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="acdb1348-148a-a716-8ba3" type="max"/>
                            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f542bcf4-f341-e83e-e49b" type="max"/>
                          </constraints>
                          <rules>
                            <rule id="6df7d200-cdf2-3fed-e4f1" name="Iron Halo" hidden="false">
                              <description>The iron halo grants a 4+ invulnerable save.</description>
                            </rule>
