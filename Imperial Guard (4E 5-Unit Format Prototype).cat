    <profile id="ef2c848b-6d0c-3605-e007" name="Inferno Cannon" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic>
        <characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic>
        <characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic>
        <characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1 Template</characteristic>
        <characteristic name="Info" typeId="33e9-27bd-77e4-401d">When firing the inferno cannon, designate a target unit and place the normal flamer template so that is at least partially over as many unit members as possible. The whole template must be in range and line of sight. Roll to hit once, using the Hellhound's BS. If you hit then all models partially or wholly under the template are hit. If you miss, they are each hit on a roll of 4+ instead.</characteristic>
      </characteristics>
    </profile>
    <profile id="330e27e4-8f95-fcf8-dfb5" name="Vanquisher Cannon" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="52616e676523232344415441232323">72"</characteristic>
        <characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic>
        <characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic>
        <characteristic name="Type" typeId="8b10-045a-f593-605e">Ordnance 1/Blast</characteristic>
        <characteristic name="Info" typeId="33e9-27bd-77e4-401d">May choose to fire an AT shell instead of using an Ordnance blast. Instead roll to hit using the crew's BS. If a hit is scored roll two D6 for Armour Penetration and add the scores together.</characteristic>
      </characteristics>
    </profile>
    <profile id="dfd0aff2-df36-3dbd-85d6" name="Volcano Cannon" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
