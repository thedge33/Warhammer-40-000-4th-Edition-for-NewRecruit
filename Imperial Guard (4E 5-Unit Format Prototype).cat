    <selectionEntry id="2758a94d-3040-e2b3-b099" name="Atlas Recovery Vehicle (IA)" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="375a-d331-f8e5-1936" type="equalTo" childName="FW: Imperial Armour"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="f018f872-f2a9-25bc-c8d9" name="Recovery Vehicle" hidden="false">
          <description>The Atlast can drag any destroyed or immobilised vehicle (friend or foe) that starts the turn in contact with it. Both vehicles may move up to D6" and must remain in base contact at the end of the move. Neither vehicle may shoot in the same turn that they are towing or being towed, except that the vehicle may fire one weapon at the Atlast if it is able and wants.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="44278248-5e9f-fe03-ac18" name="Atlas" hidden="false" targetId="e3e81114-37ec-2a73-726b" type="profile"/>
