    <selectionEntry id="ed976d3e-b614-e82c-37f2" name="Captain Obadiah Schfeer (IA)" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="375a-d331-f8e5-1936" type="equalTo" childName="FW: Imperial Armour"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="8d19ae58-05ae-fbae-7d36" name="My Boys Love It" hidden="false">
          <description>Obadiah's tank is converted to varry a loud speaker system. Over this, he broadcasts orders to the rest of the company and loud Varolian martial music to inspire the boys and frighten the enemy (Varolian martial music is very loud, long, and to the untrained ear, quite painful). When Obadiah's tank forces a Tank Shock test on an enemy unit, they must make the test at -1 to their Leadership.</description>
        </rule>
        <rule id="791ebd3e-a83d-cbc6-b3d4" name="Tank Hunters" hidden="false">
          <description>Add +1 to all Armour Penetration rolls</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4ce94688-efde-e197-b190" name="Leman Russ Vanquisher" hidden="false" targetId="b7565c8e-64f4-09c0-944e" type="profile">
