    <selectionEntry id="da8fe27d-3b15-9d4a-616a" name="Baneblade (IA)" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="375a-d331-f8e5-1936" type="equalTo" childName="FW: Imperial Armour"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="cf6331ab-f77a-48f9-a6d3" name="Difficult Terrain" hidden="false">
          <description>The Stormsword can ignore low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule id="e3582f7e-2836-cacc-b962" name="Lumbering Vehicle" hidden="false">
          <description>The stormsword can move up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="698ae6a1-96b4-0f5c-7657" name="Ordnance" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule id="8ea40e53-3108-1aeb-c0b7" name="Targetting" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons. The co-axial autocannon must fire at the same target as the Baneblade Battle Cannon</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="28114e1c-16a5-c307-4311" name="Heavy Bolter" hidden="false" targetId="0e61-328d-62cd-8b59" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="3x Twin-Linked Heavy Bolters"/>
          </modifiers>
        </infoLink>
        <infoLink id="8f42b19e-586f-2014-8f39" name="Twin-Linked" hidden="false" targetId="91b9-40d6-1ecb-6414" type="rule"/>
        <infoLink id="154bedcb-647c-7afe-049c" name="Baneblade" hidden="false" targetId="f84f80e3-f6fe-237b-8e92" type="profile"/>
