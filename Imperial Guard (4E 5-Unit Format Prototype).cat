        <selectionEntry id="a6747913-62fe-8856-5a48" name="Siege Shells" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e3d8d3cb-050c-eec2-bce9" type="max"/>
          </constraints>
          <rules>
            <rule id="c98e8705-fdca-769b-caea" name="Siege Shells" hidden="false">
              <description>Choose to fire a siege round instead of a normal round. These rounds use the small Blast template, but roll 2D6+5 when rolling for Armour Penetration against bunkers and buildings instead of the normal 2D6 choose the highest. Siege shells affect models inside buildings on a 4+ instead of a 6.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="4deb-313d-6685-f48b" value="5"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
