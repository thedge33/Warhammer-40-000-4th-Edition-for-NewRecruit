    <selectionEntry id="62b983b6-d4bc-d8f7-5612" name="Colonel-Commissar Ibram Gaunt" hidden="false" collective="false" import="true" type="model">
      <rules>
        <rule id="9d410a8f-a28c-7699-447a" name="Front-liner" hidden="false">
          <description>If there is an assault occuring within 12" of Gaunt at the start of the Imperial Guard player's turn and he is not in combat, he must immediately move towards the nearest combat in his Movement phase and assault the enemy models in that combat if at all possible. However, when Gaunt charges into an assault, all Tanith Imperial Guard models in that combat benefit from +1A for that round only (including Gaunt).</description>
        </rule>
        <rule id="c56dc36a-0092-a93b-badd" name="Leader" hidden="false">
          <description>Any Imperial Guard squad within 12" of Gaunt may use his Leadership value for all Morale and Pinning tests.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="52a710e0-2fbc-7311-7363" name="Colonel-Commissar Ibram Gaunt" hidden="false" targetId="af4bba11-385e-2886-7ba8" type="profile"/>
