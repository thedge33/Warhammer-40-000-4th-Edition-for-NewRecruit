    <selectionEntry id="37456248-a64c-77ae-2269" name="Commissar Yarrick" hidden="false" collective="false" import="true" type="model">
      <rules>
        <rule id="1e814841-89c2-d33e-3668" name="Force Field" hidden="false">
          <description>Each time Yarrick is hit, roll a D6 and deduct the number shown on the dice from the Strength of the attack. If reduced to 0 or less, the attack is stopped completely. The force field has no effect on attacks that do not use Strength to inflict damage.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="be41d0a8-d6ee-f7c3-336a" name="Commissar Yarrick" hidden="false" targetId="8f215d06-5ce6-bec2-3b43" type="profile"/>
