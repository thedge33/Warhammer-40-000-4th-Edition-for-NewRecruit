                <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="091dac89-d300-6c46-d267" type="notEqualTo"/>
                <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="8b2c6a32-05e9-0405-e16c" type="notEqualTo"/>
                <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="7fcdace0-9ebf-61a1-4966" type="notEqualTo"/>
