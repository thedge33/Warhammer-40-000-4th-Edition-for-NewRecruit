      <rules>
        <rule id="460872d2-9c16-5e17-4a2e" name="Go To Ground" hidden="false">
          <description>When in cover Ratlings get a +1 bonus to their Cover saving throws. Additionally, if required to take a Morale test for suffering 25% casualties and are in cover, they may instead opt to be Pinned rather than take the test.</description>
        </rule>
      </rules>
