      <constraints>
        <constraint field="selections" scope="force" value="-1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4d225580-21f8-038c-95df" type="max"/>
      </constraints>
      <rules>
        <rule id="b6d44c00-264b-4de1-5b9a" name="Fanatical" hidden="false">
          <description>A Priest and the unit he is assigned to may re-roll any failed to hit rolls once in the turn they charge while the Priest lives.</description>
        </rule>
        <rule id="191a292c-f525-4949-48c7" name="Righteous Fury" hidden="false">
          <description>A unit including a Priest must charge in the Assault phase if there is an enemy in reach. In addition, such is the state of agitation that they always count as moving even if the models are stationary, so would be unable to fire heavy weapons.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4a6b4766-2648-e008-9161" name="Priest" hidden="false" targetId="75019f08-4819-84b0-7229" type="profile"/>
