    <selectionEntry id="47c9b82a-b48e-e3cb-a3c3" name="Priests" hidden="false" collective="false" import="true" type="model">
      <modifiers>
        <modifier type="set" field="4d225580-21f8-038c-95df" value="0">
          <conditionGroups>
