            <selectionEntry id="548c91fd-a36e-97af-7bdd" name="Medic" hidden="false" collective="false" import="true" type="upgrade" sortIndex="4">
              <comment>For the one in CCS's</comment>
              <rules>
                <rule id="5ab6faca-7a26-e53a-6963" name="Medi-pack" hidden="false">
                  <description>Medi-packs allow a unit with a medic to ignore the first failed saving throw it rolls in every turn. The medi-pack may not be used on any model which suffers instant death or that has been hit by a close combat weapon that allows no Amrour save. It may not be used if the medic is in base contact with an enemy model.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="e282533e-8947-f8f5-7fa6" name="Veteran" hidden="false" targetId="f241f2c9-f813-91c8-9270" type="profile">
