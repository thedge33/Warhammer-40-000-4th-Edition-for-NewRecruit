                    <selectionEntryGroup id="80e0018a-ec53-a368-0f75" name="Wargear" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint field="4deb-313d-6685-f48b" scope="parent" value="100" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2b3d5ce6-7456-1fb4-a67b" type="max"/>
                      </constraints>
                      <selectionEntries>
                        <selectionEntry id="72bb503e-f605-0914-31c8" name="Auspex" hidden="false" collective="false" import="true" type="upgrade">
                          <constraints>
                            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a7d3d0aa-97c8-18a4-b15c" type="max"/>
                          </constraints>
                          <rules>
                            <rule id="d15c1bf6-ce20-581e-9d26" name="Auspex" hidden="false">
                              <description>If enemy infiltrators set up within 4D6" of a model with a auspex, then that model and the unit they are attached to is allowed to take a "free" shot at them. These shots are taken before the battle begins and may cause the infiltrators to fall back.</description>
                            </rule>
                          </rules>
                          <costs>
                            <cost name="Points" typeId="4deb-313d-6685-f48b" value="2"/>
                          </costs>
                        </selectionEntry>
                        <selectionEntry id="cfdde2a1-f1bf-3889-01c8" name="Bionics" hidden="false" collective="false" import="true" type="upgrade">
                          <constraints>
                            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9e01c320-445f-6fc9-07db" type="max"/>
                          </constraints>
                          <rules>
                            <rule id="fda5643e-d553-6d73-a7d8" name="Bionics" hidden="false">
                              <description>If a model with bionics is killed, instead of removing it, place it on its side. Roll a D6 at the start of the next turn; on a roll of a 6 the model stands back up with 1 wound.</description>
                            </rule>
                          </rules>
                          <costs>
                            <cost name="Points" typeId="4deb-313d-6685-f48b" value="10"/>
                          </costs>
                        </selectionEntry>
                        <selectionEntry id="2f1cac80-d911-2f10-a7b0" name="Frag Grenades" hidden="false" collective="false" import="true" type="upgrade">
                          <constraints>
                            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f1b09b16-db1c-4995-c33c" type="max"/>
