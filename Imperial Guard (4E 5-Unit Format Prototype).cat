      <rules>
        <rule id="fce4caed-466b-7252-fe95" name="Targetting" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons.</description>
        </rule>
        <rule id="58fdab5b-d3ba-4724-6f37" name="Ordnance" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule id="23e3873c-6d9b-4aa6-6461" name="Difficult Terrain" hidden="false">
          <description>Ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule id="3c5372ad-f9a6-2614-a2b2" name="Lumbering Vehicle" hidden="false">
          <description>Moves up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="005e5ae7-bfb3-334c-48e8" name="Tank Shock" hidden="false">
          <description>Enemy infantry must test at -1 Leadership if they are Tank Shocked.</description>
        </rule>
      </rules>
