          <selectionEntries>
            <selectionEntry id="fb04ad22-cee9-06d7-f853" name="Rhino" hidden="false" collective="false" import="true" type="model">
              <profiles>
                <profile id="63e44595-70ef-36c2-f64f" name="Rhino" hidden="false" typeId="56656869636c6523232344415441232323" typeName="Vehicle">
                  <characteristics>
                    <characteristic name="Front" typeId="46726f6e7423232344415441232323">11</characteristic>
                    <characteristic name="Side" typeId="5.369646523232344e+27">11</characteristic>
                    <characteristic name="Rear" typeId="5.265617223232345e+27">10</characteristic>
                    <characteristic name="BS" typeId="a6a5-1595-da9e-6155">4</characteristic>
                    <characteristic name="Type" typeId="5.479706523232345e+27">Tank</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="ba55b1f6-b72c-778a-3365" name="Reliability" hidden="false">
                  <description>If a Rhino is immobilised and spends a turn without firing any weapons its drive may be able to effect a temporary repair that turn. On a D6 roll of 6 the vehicle will be free to move in its next Movement phase.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="c746be17-6829-6d45-4259" name="Storm Bolter" hidden="false" targetId="d5e9-6e7d-416d-6b6a" type="profile"/>
              </infoLinks>
              <categoryLinks>
                <categoryLink id="3f2f947e-d9fc-58db-5410" name="Dedicated Transport" hidden="false" targetId="31675589-cd46-7494-21f4" primary="true"/>
              </categoryLinks>
              <selectionEntryGroups>
                <selectionEntryGroup id="dc83338f-c02f-bd50-47d8" name="Space Marine Vehicle Upgrades" hidden="false" collective="false" import="true">
                  <selectionEntries>
                    <selectionEntry id="76a475bc-54c5-ac39-3346" name="Dozer Blade" hidden="false" collective="false" import="true" type="upgrade">
                      <constraints>
                        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5d1b773b-659f-6fd1-160c" type="max"/>
                      </constraints>
                      <rules>
                        <rule id="8414cc75-c7a2-a3b5-95ba" name="Dozer Blade" hidden="false">
                          <description>Re-roll failed Difficult Terrain tests as long as the model did not move more than 6" that turn.</description>
                        </rule>
                      </rules>
                      <costs>
                        <cost name="Points" typeId="4deb-313d-6685-f48b" value="5"/>
                      </costs>
                    </selectionEntry>
                    <selectionEntry id="10a499be-47dc-4154-5252" name="Extra Armor" hidden="false" collective="false" import="true" type="upgrade">
                      <constraints>
                        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="988c4359-ec3c-314f-9f89" type="max"/>
                      </constraints>
                      <rules>
                        <rule id="f0f27462-ac63-0a10-be23" name="Extra Armour" hidden="false">
                          <description>Treat 'Crew Stunned' results as 'Crew Shakeen' instead.</description>
                        </rule>
                      </rules>
                      <costs>
                        <cost name="Points" typeId="4deb-313d-6685-f48b" value="5"/>
                      </costs>
                    </selectionEntry>
                    <selectionEntry id="97190c84-3789-4d0b-0ab8" name="Hunter-killer Missile" hidden="false" collective="false" import="true" type="upgrade">
                      <constraints>
                        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a5b8916f-bed3-4a1e-f8b8" type="max"/>
