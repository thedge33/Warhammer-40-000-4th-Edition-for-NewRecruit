      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="375a-d331-f8e5-1936" type="equalTo" childName="FW: Imperial Armour"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="02cbdfee-bed1-737b-27e4" name="Remote Controlled" hidden="false">
          <description>The Cyclops is controlled by a single guardsman, or by the crew of a transporting Chimera. It moves independently of its controller, but it must remain with 48" of the controller, otherwise it simple stops and cannot do anything until control is restored.
During the Imperial Guard Shooting Phase the Cyclops can be detonated. Place the Ordnance template centered on the Cyclops. It is destroyed during the explosion.</description>
        </rule>
        <rule id="92949f4d-2cde-5f35-c3d4" name="Damage" hidden="false">
          <description>The Cyclops is destroyed by any glancing or penetrating hits. When rolling for armour penetration, if a weapon scores a 6, and this results in a penetrating hit, then the Cyclops explodes as normal.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d3e8a5e2-3a83-84c4-58dd" name="Cyclops" hidden="false" targetId="3a6e47c0-33d5-da12-72b4" type="profile"/>
        <infoLink id="77f561ef-445a-fcbd-7b5d" name="Demolition Charge" hidden="false" targetId="b0041971-e24a-7045-a6b4" type="profile"/>
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="2c66dbbd-8521-0f76-09bb" name="Operator" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c5185c22-5a72-17d3-2cb6" type="max"/>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6e201e75-1b3c-463b-adeb" type="min"/>
