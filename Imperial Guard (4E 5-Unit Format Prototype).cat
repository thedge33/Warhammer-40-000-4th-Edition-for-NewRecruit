    <selectionEntry id="3366a6f4-4858-0384-a9d1" name="Tarantula Sentry Gun (IA)" hidden="false" collective="false" import="true" type="upgrade">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="375a-d331-f8e5-1936" type="equalTo" childName="FW: Imperial Armour"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="7e7bd711-5d42-7e24-dd87" name="Firing Modes" hidden="false">
          <description>At deployment, you must select a firing mode. It cannot be changed once the game begins.

Point Defence Mode: Choose a fixed 90 degree arc. The gun will engage enemy targets up to 24" away within the arc.

Sentry Mode: The gun will fire at the nearest enemy target within 12" that it can see.</description>
        </rule>
        <rule id="a7d86dde-4721-594a-1216" name="Targetting Priority" hidden="false">
          <description>A heavy bolter Sentry gun will fire at the nearest non-vehicle unit it can hit. A lascannon Sentry gun will fire at the closest enemy vehicle it can hit. If no preferred target can be hit they will shoot at non-preferred targets.</description>
        </rule>
        <rule id="50696c7a-2cd6-006c-fa63" name="Damage" hidden="false">
          <description>A Tarantula is destroyed by any glancing or penetrating hit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6d02a3aa-8fd8-a246-d8e1" name="Immobile" hidden="false" targetId="de29c25a-7eb5-a73a-136f" type="rule"/>
