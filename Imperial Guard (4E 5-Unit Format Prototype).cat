        <infoLink id="e5812a6f-12a4-2214-03f0" name="Demolisher" hidden="false" targetId="7894-54a9-6029-a069" type="profile"/>
        <infoLink id="3a0e547a-b357-ad0b-c237" name="Lascannon" hidden="false" targetId="a985-b7e4-1396-ce64" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="2x Lascannons"/>
          </modifiers>
        </infoLink>
        <infoLink id="877fbb90-242b-e865-b2fc" name="Autocannon" hidden="false" targetId="7d29-c50b-9499-c31b" type="profile"/>
