      <entryLinks>
        <entryLink id="c71feb8b-3d90-3a56-6cee" name="Wargear" hidden="false" collective="false" import="true" targetId="fa2b972b-342c-873d-bebe" type="selectionEntryGroup" sortIndex="2">
          <modifiers>
            <modifier type="set" field="94f4b019-9aff-8a12-1d8d" value="100">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="cbf143a8-b1fc-5051-7590" type="instanceOf"/>
                    <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e00682a5-9da3-4bc2-7d02" type="instanceOf"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
