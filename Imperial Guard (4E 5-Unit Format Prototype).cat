                      </costs>
                    </selectionEntry>
                    <selectionEntry id="69421bfe-869c-a1cc-6719" name="Pintle-mounted Storm Bolter" hidden="false" collective="false" import="true" type="upgrade">
                      <constraints>
                        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9f94c186-5fda-2ae5-3302" type="max"/>
